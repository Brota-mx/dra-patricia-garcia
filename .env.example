# ─────────────────────────────────────────────────────────────────────────────
# Dra. Patricia García — plantilla de variables de entorno
#
# 🔒 SOLO NOMBRES, NUNCA VALORES REALES. Los secretos se escriben directo en
#    Vercel (Production + Preview) o en .env.local. Nunca en el repo, nunca en
#    el chat, nunca en el vault.
# ─────────────────────────────────────────────────────────────────────────────

# Sitio
NEXT_PUBLIC_SITE_URL=

# Contacto y agenda — TODO(cliente): pedir a la doctora
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CALCOM_LINK=

# Sanity (blog) — sanity.io/manage, cuenta de Brota
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Solo para scripts/seed-sanity.mjs (sembrar artículos) — token con permiso de
# escritura. NUNCA en Vercel/producción: se usa una vez, en local, y se borra.
SANITY_API_WRITE_TOKEN=

# Resend (correo del formulario) — resend.com, cuenta de Brota
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Upstash Redis (rate limiting de /api/contact) — upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (anti-bot) — dash.cloudflare.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Feature flags — 🔴 mantener en false hasta autorización legal del cliente
# (consentimientos firmados + viabilidad regulatoria). Ver BLUEPRINT.md §8.2
NEXT_PUBLIC_FEATURE_BEFORE_AFTER=false
NEXT_PUBLIC_FEATURE_TESTIMONIALS=false
